<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:label="@string/app_name" android:allowBackup="false">
        <!-- The agentActions entry point. Dogo finds it by this intent action
             and reads assets/dogo-plugin.json for what it offers. -->
        <service
            android:name=".NotesActionService"
            android:exported="true">
            <intent-filter>
                <action android:name="app.dogo.launcher.PLUGIN" />
            </intent-filter>
        </service>
    </application>
</manifest>
